# ── Database connection ────────────────────────────────────────────────────────
# Individual parts — used to build the connection URL when DATABASE_URL is not set.
DB_HOST=localhost
DB_PORT=5432
DB_USER=credit_user
DB_PASSWORD=
DB_NAME=credit_ratings

# Full URL override — takes precedence over the individual vars above.
# Set this in production / Docker instead of the individual vars.
# DATABASE_URL=postgresql://credit_user:secret@localhost:5432/credit_ratings

# ── Connection pool ────────────────────────────────────────────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Pipeline ───────────────────────────────────────────────────────────────────
DATA_DIR=/app/data
LOG_LEVEL=INFO

# ── Tests ──────────────────────────────────────────────────────────────────────
# Override to run tests against a real database instead of SQLite.
# TEST_DATABASE_URL=sqlite:///./test.db
